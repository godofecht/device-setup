# Secure Vault Environment Configuration
# Copy this to .env and update with actual paths

# GPG Key ID for decryption (find with: gpg --list-keys --keyid-format LONG)
GPG_KEY_ID=""

# Path to secure vault repository
VAULT_PATH="$HOME/secure-vault"

# Path to encrypted credentials file
CREDENTIALS_FILE="$VAULT_PATH/credentials.gpg"

# VPS Connection (decrypt to get actual values)
VPS_HOST=""
VPS_USER="root"
VPS_PORT="22"

# Database Connection (decrypt to get actual values)
DB_HOST="localhost"
DB_USER="admin"
DB_PORT="3306"

# Helper function to decrypt credentials
decrypt_credentials() {
    gpg --decrypt "$CREDENTIALS_FILE" 2>/dev/null
}

# Helper to get specific value
get_credential() {
    local key="$1"
    decrypt_credentials | grep "^$key:" | cut -d: -f2 | tr -d ' '
}
